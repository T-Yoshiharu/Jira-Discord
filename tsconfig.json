{
    "compilerOptions": {
        "target": "ES2019",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": [
            "ESNext"
        ],
        "strict": true,
        "noImplicitAny": true,
        "types": [
            "google-apps-script"
        ],
        "rootDir": "./src",
        "noEmit": true
    },
    "include": [
        "src/**/*"
    ]
}